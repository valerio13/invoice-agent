# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by docker-compose and by the backend)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/DB with the three values above.
# Use a password of letters and digits only: other characters would need escaping in the URL.
DATABASE_URL=

# LLM: LLM_PROVIDER is "fake" (reads the expected demo data, no key) or "openrouter" (any model through OpenRouter).
# LLM_MODEL is an OpenRouter model id, for example anthropic/claude-haiku-5.5
LLM_PROVIDER=fake
LLM_MODEL=anthropic/claude-haiku-5.5
# Create a key at https://openrouter.ai/keys. Only needed with LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# App
DEMO_MODE=true
